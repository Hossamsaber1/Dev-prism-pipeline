# Normalize line endings: store all text files as LF in the repo.
# Git will convert to the OS default on checkout (LF on Linux/Mac, CRLF on Windows).
* text=auto eol=lf

# Windows batch / cmd scripts must keep CRLF so they run correctly on Windows
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files — never touch line endings or diff as text
*.exe binary
*.dll binary
*.pyd binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.tif binary
*.tiff binary
*.exr binary
*.mp4 binary
*.mov binary
*.avi binary
*.m4v binary
*.mxf binary
*.hdr binary
*.dpx binary
